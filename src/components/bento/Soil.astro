---
// Glacier tile in the spatiali.se language: topographic contour lines, a
// frosted-glass stat card, and an isometric stack of raster layers
// (parcels → imagery → predicted soil organic carbon).
import { contourPath } from '../../utils/contours'

// --- background contours (smooth field of a few blobs, 271x160 tile space)
const blobs = [
	[40, 120, 55, 1],
	[130, 40, 60, 0.9],
	[225, 110, 50, 0.95],
	[190, 10, 40, 0.6],
	[75, 20, 35, 0.5]
]
const field = (x: number, y: number) =>
	blobs.reduce((s, [bx, by, r, a]) => s + a * Math.exp(-((x - bx) ** 2 + (y - by) ** 2) / (2 * r * r)), 0) + 0.04 * Math.sin(x * 0.09 + y * 0.06)
const contours = contourPath(271, 160, 5, Array.from({ length: 14 }, (_, k) => 0.08 + k * 0.085), field)

// --- isometric stack (own 150x134 space): P(u,v) maps a unit square to a diamond
const CX = 75,
	HW = 60,
	HH = 30,
	DY = 20
const P = (u: number, v: number, cy: number) => [CX + (u - v) * HW, cy + (u + v - 1) * HH]
const pts = (cy: number, ...uv: number[][]) => uv.map(([u, v]) => P(u, v, cy).map((n) => n.toFixed(1)).join(',')).join(' ')
const quad = (cy: number) => pts(cy, [0, 0], [1, 0], [1, 1], [0, 1])
const TOP = 36,
	MID = TOP + DY,
	BOT = TOP + 2 * DY

const RAMP = ['#eef3f0', '#d8ece4', '#b9d6d3', '#8fb3bd', '#5f8199', '#2f4a60']
const G = 9
const soc = (u: number, v: number) =>
	0.55 * Math.exp(-((u - 0.3) ** 2 + (v - 0.35) ** 2) / 0.05) +
	0.5 * Math.exp(-((u - 0.72) ** 2 + (v - 0.7) ** 2) / 0.07) +
	0.25 * (u * 0.6 + v * 0.3) +
	0.12 * Math.sin(6 * u + 4 * v)
const cells = Array.from({ length: G * G }, (_, n) => {
	const i = n % G
	const j = Math.floor(n / G)
	const t = Math.min(Math.max(soc((i + 0.5) / G, (j + 0.5) / G), 0), 0.999)
	return { d: i + j, fill: RAMP[Math.floor(t * RAMP.length)], pts: pts(TOP, [i / G, j / G], [(i + 1) / G, j / G], [(i + 1) / G, (j + 1) / G], [i / G, (j + 1) / G]) }
})
// imagery layer speckles + parcel grid
const hash = (n: number) => Math.abs(Math.sin(n * 12.9898) * 43758.5453) % 1
const specks = Array.from({ length: 44 }, (_, n) => P(hash(n * 2 + 1), hash(n * 2 + 2), MID))
const grid = Array.from({ length: 5 }, (_, k) => (k + 1) / 6)
const mono = 'font-family:ui-monospace,SFMono-Regular,Menlo,monospace'
---

<div class='relative h-full w-full overflow-hidden'>
	<svg viewBox='0 0 271 160' preserveAspectRatio='xMidYMid slice' class='absolute inset-0 h-full w-full' aria-hidden='true'>
		<path class='soil-drift' d={contours} fill='none' stroke='#0b0f14' stroke-opacity='0.2' stroke-width='0.5'></path>
	</svg>

	<svg
		viewBox='0 0 150 134'
		class='absolute right-1.5 top-8 h-[calc(100%-5.6rem)] w-auto sm:h-[calc(100%-2.4rem)]'
		role='img'
		aria-label='Isometric stack: parcels, satellite imagery, predicted soil organic carbon raster'
	>
		<defs>
			<linearGradient id='sl-mid' x1='0' y1='0' x2='0' y2='1'>
				<stop offset='0' stop-color='#c9dae2'></stop>
				<stop offset='1' stop-color='#8fa9b8'></stop>
			</linearGradient>
		</defs>
		<!-- dashed risers -->
		<g stroke='#0b0f14' stroke-opacity='0.35' stroke-width='0.5' stroke-dasharray='1.5 1.5'>
			{[[15, 36], [135, 36], [75, 66]].map(([x, y]) => <line x1={x} y1={y} x2={x} y2={y + 2 * DY}></line>)}
		</g>
		<!-- parcels (bottom) -->
		<polygon points={quad(BOT)} fill='#0b0f14' fill-opacity='0.88' stroke='#0b0f14' stroke-width='0.5'></polygon>
		<g stroke='#dfe9ee' stroke-opacity='0.28' stroke-width='0.35'>
			{grid.map((k) => <line x1={P(k, 0, BOT)[0]} y1={P(k, 0, BOT)[1]} x2={P(k, 1, BOT)[0]} y2={P(k, 1, BOT)[1]}></line>)}
			{grid.map((k) => <line x1={P(0, k, BOT)[0]} y1={P(0, k, BOT)[1]} x2={P(1, k, BOT)[0]} y2={P(1, k, BOT)[1]}></line>)}
		</g>
		<!-- imagery (middle) -->
		<polygon points={quad(MID)} fill='url(#sl-mid)' stroke='#0b0f14' stroke-opacity='0.5' stroke-width='0.5'></polygon>
		<g fill='#0b0f14' fill-opacity='0.35'>
			{specks.map(([x, y]) => <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r='0.7'></circle>)}
		</g>
		<!-- predicted SOC raster (top) -->
		<g stroke='#f1efea' stroke-width='0.35' stroke-linejoin='round'>
			{cells.map((c) => <polygon class='soil-cell' style={`--d:${c.d}`} points={c.pts} fill={c.fill}></polygon>)}
		</g>
		<polygon points={quad(TOP)} fill='none' stroke='#0b0f14' stroke-opacity='0.55' stroke-width='0.5'></polygon>
		<!-- legend -->
		{RAMP.map((c, i) => <rect x={27 + i * 16} y='116' width='16' height='4' fill={c}></rect>)}
		<text x='27' y='129' font-size='5.2' letter-spacing='0.5' fill='#0b0f14' fill-opacity='0.55' style={mono}>LOW</text>
		<text x='75' y='129' font-size='5.2' letter-spacing='0.5' text-anchor='middle' fill='#0b0f14' fill-opacity='0.55' style={mono}>SOC</text>
		<text x='123' y='129' font-size='5.2' letter-spacing='0.5' text-anchor='end' fill='#0b0f14' fill-opacity='0.55' style={mono}>HIGH</text>
	</svg>

	<div class='absolute bottom-2 left-2 rounded-lg bg-white/45 px-2 py-1.5 ring-1 ring-black/5 backdrop-blur-md sm:px-2.5 sm:py-2'>
		<p class='font-newsreader text-[1.7rem] font-light leading-none tracking-tight sm:text-[2.1rem]'>200K+</p>
		<p class='mt-1 font-mono text-[0.45rem] uppercase leading-snug tracking-wider opacity-60 sm:text-[0.5rem]'>hectares mapped<br />predicted with GNNs</p>
	</div>
	<p class='absolute right-3 top-3.5 hidden font-mono text-[0.5rem] uppercase tracking-wider opacity-45 sm:block'>fig 6 · soc</p>
</div>

<style>
	.soil-drift {
		animation: soil-drift-kf 18s ease-in-out infinite alternate;
	}
	@keyframes soil-drift-kf {
		to {
			transform: translate(-5px, 3px);
		}
	}
	/* inference sweep: a dim ripple travels diagonally across the prediction raster */
	.soil-cell {
		animation: soil-scan 7s ease-in-out infinite;
		animation-delay: calc(var(--d) * 0.26s);
	}
	@keyframes soil-scan {
		0%,
		24%,
		100% {
			opacity: 1;
		}
		10% {
			opacity: 0.22;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.soil-drift,
		.soil-cell {
			animation: none;
		}
	}
</style>
