---
// Object format, 2x2 tile: a results panel on the left (the plate: number + what it was, one per system) and real-3D devices
// rocking in perspective on the right, one 30 s loop that follows the three systems. A titanium phone (a stack of slabs, so
// the rim has thickness at any angle) plays the first two:
//   0–10 s   Maia v1  a WhatsApp sale ($55M)  ->  Style-transfer wipe  ->  Maia v2  the inbox streaming past (600K)
// then the camera swaps to the platform, the web app, where Yago lives: a browser window with the dashboard and Yago's dock
// floating above it (the dock is lifted in 3D, so it parallaxes as the window turns), and the camera pushes in on it:
//   10–15    Yago edits the seller from a request: the card, the before/after row, "Apply and publish", and the page changes
//   15–20    Yago reads a conversation that went wrong and finds the stale FAQ behind it
//   20–24    Yago guides: a link in its answer navigates the page in place (the real behaviour: no highlight overlay)
// and the phone returns (24–30) with the same Yago in the mobile app. The panel's description follows each capability.
// Below ~440 px of tile width (phones) the panel drops under the devices (container query), sizes follow the tile width (cqw).
// DATA: the panel's numbers/wording are his (LinkedIn). ILLUSTRATIVE (English; the product wording follows the real
// en locale): the sale, the inbox rows (shapes, no real chats), the dashboard stand-in, and the Yago requests/cards (they
// follow the product's real card: line, before/after row struck through, approve button). Everything is CSS: the timeline is
// authored in seconds below and turned into @keyframes. Names are prefixed yv-: Astro doesn't scope @keyframes.
const LOOP = 30 // seconds

// ---- the words on the devices (English) ----
const L = {
	biz: 'Andina Store',
	bizSub: 'Business account',
	today: 'Today',
	m1: 'Hi, do you have trail running shoes in size 42?',
	m2: "Hi! Yes. Here's our most popular one:",
	prod: 'Trail Pro',
	price: 'S/ 289 · size 42',
	m4: 'That one. Can I pay with Yape?',
	m5: "Sure. Here's your payment link.",
	ok: 'Order confirmed ✓',
	chats: 'Chats',
	all: 'All',
	unread: 'Unread',
	test: 'Test your seller',
	yago: 'Yago',
	req: 'Warmer with wholesalers.',
	done: 'Done',
	line: 'Warmer with wholesalers',
	styleLong: 'Communication style',
	style: 'Style',
	warm: 'Warm and concise',
	neutral: 'Neutral',
	apply: 'Apply and publish',
	pub: 'Published ✓',
	personality: 'Personality',
	audience: 'Target audience',
	handoff: 'Human handoff',
	conversations: 'Conversations',
	q1: 'Do you ship to Arequipa?',
	a1: 'For now we only ship to Lima.',
	hours: 'Hours',
	times: ['9 am – 6 pm', '9 am – 1 pm', 'Closed'],
	ask2: 'Why did it say that to Rocío?',
	ans2: 'Your FAQ “Do you ship?” says “Lima only.”',
	line2: 'Shipping to all of Peru',
	answer: 'Answer',
	new2: 'Yes, all over Peru',
	old2: 'Lima only',
	ask3: 'Where do I change my hours?',
	ans3a: 'You change it in ',
	ans3b: 'Hours',
	ans3c: '.',
	url: 'app.yavendio.com'
}

const css: string[] = []
let nk = 0
const pc = (s: number) => `${+((Math.min(Math.max(s, 0), LOOP) / LOOP) * 100).toFixed(3)}%`
/** register @keyframes from [seconds, declarations] steps (0 % and 100 % are filled from the first/last step) */
const kf = (steps: [number, string][], name = `yvk${nk++}`) => {
	const st = [...steps].sort((a, b) => a[0] - b[0])
	if (st[0][0] > 0) st.unshift([0, st[0][1]])
	if (st[st.length - 1][0] < LOOP) st.push([LOOP, st[st.length - 1][1]])
	css.push(`@keyframes ${name}{${st.map(([s, d]) => `${pc(s)}{${d}}`).join('')}}`)
	return name
}
const use = (name: string, ease = 'ease-out') => `animation:${name} ${LOOP}s ${ease} infinite;`
/** visible from a to b (fading f s in and out), optionally rising by `rise` as it appears */
const win = (a: number, b: number, rise = '', f = 0.35) => {
	const hid = `opacity:0${rise ? `;transform:translateY(${rise})` : ''}`
	const vis = `opacity:1${rise ? ';transform:none' : ''}`
	return use(kf([[a, hid], [a + f, vis], [b, vis], [b + f, 'opacity:0']]))
}
/** typing dots: appear at a, collapse again at b */
const dotsWin = (a: number, b: number) =>
	use(kf([[a, 'opacity:0;max-height:0;margin:0'], [a + 0.4, 'opacity:1;max-height:2em;margin:.45em 0 0'], [b, 'opacity:1;max-height:2em;margin:.45em 0 0'], [b + 0.4, 'opacity:0;max-height:0;margin:0']]))

const SLABS = 14 // phone body layers, back (dark) to front (light)
const mix = (a: number, b: number, t: number) => Math.round(a + (b - a) * t)
const slabs = Array.from({ length: SLABS }, (_, k) => {
	const t = k / (SLABS - 1)
	return { z: ((k - (SLABS - 1)) * 0.12).toFixed(3), c: `rgb(${mix(78, 196, t)},${mix(84, 202, t)},${mix(92, 208, t)})` }
})
const wslabs = Array.from({ length: 6 }, (_, k) => ({ z: ((k - 5) * 0.09).toFixed(3), c: `rgb(${mix(118, 190, k / 5)},${mix(130, 202, k / 5)},${mix(142, 212, k / 5)})` }))

const faces = [
	{ n: '$55M', note: 'in sales closed end-to-end by one multi-tenant shopping agent' },
	{ n: '600K', note: 'conversations a month, after rebuilding the agent from scratch' },
	{ n: 'Yago', note: '' }
]
// the Yago face's description, one line per capability on screen (the first is his sentence)
const yagoLines = [
	{ t: 'backoffice agent handling <b>10K</b> conversations a month, self-improving', a: 10.6, b: 15.2 },
	{ t: 'reads a chat that went wrong and finds why', a: 15.2, b: 19.8 },
	{ t: 'guides you around the platform', a: 19.8, b: 24.0 },
	{ t: 'the same Yago, on your phone', a: 24.0, b: 29.4 }
]
const agents = ['Maia v1', 'Maia v2', 'Yago v2']
// panel faces / agent dots: [start, end] of each system, crossfading (the last one wraps around the loop seamlessly)
const SPAN = [[0, 5], [5, 10], [10, 30]]
const faceKf = (i: number, vis: string, hid: string) => {
	const [a, b] = SPAN[i]
	const f = 0.6
	const steps: [number, string][] =
		i === 0 ? [[0, vis], [b - f, vis], [b, hid], [LOOP - f, hid], [LOOP, vis]] : i === 2 ? [[0, hid], [a, hid], [a + f, vis], [LOOP - f, vis], [LOOP, hid]] : [[0, hid], [a, hid], [a + f, vis], [b - f, vis], [b, hid]]
	return use(kf(steps), 'ease-in-out')
}

// sparse digit contours for the panel's lower part (static): a short strip for the narrow tile, a taller field for the wide panel
const COLS = 46
const hash = (c: number, r: number) => Math.abs(((c * 73856093) ^ (r * 19349663)) % 1000) / 1000
const texture = (ROWS: number, blobs: number[][]) => {
	const val = (c: number, r: number) =>
		blobs.reduce((v, [bx, by, sd]) => v + Math.exp(-(((c + 0.5) * 5.4 - bx) ** 2 + ((r + 0.5) * 10.5 - by) ** 2) / (2 * sd * sd)), 0)
	const lv = Array.from({ length: ROWS }, (_, r) => Array.from({ length: COLS }, (_, c) => Math.min(Math.floor(val(c, r) * 5), 5)))
	let d = ''
	let g = ''
	for (let r = 0; r < ROWS; r++) {
		for (let c = 0; c < COLS; c++) {
			const Lv = lv[r][c]
			const edge = Lv >= 1 && ((c < COLS - 1 && lv[r][c + 1] !== Lv) || (r < ROWS - 1 && lv[r + 1][c] !== Lv))
			d += (edge ? hash(c, r) < 0.7 : Lv >= 1 && hash(c, r) < 0.04) ? String(Math.min(Lv + 3, 9)) : ' '
			g += val(c, r) > 0.45 ? '█' : ' '
		}
		d += '\n'
		g += '\n'
	}
	return { d, g }
}
const short = texture(5, [[62, 22, 24], [160, 28, 32], [225, 18, 18]])
const tall = texture(12, [[62, 94, 24], [160, 100, 32], [225, 88, 18], [90, 52, 26], [36, 66, 18], [150, 56, 22]])

// ---------------- the timeline (seconds) ----------------
const T = {
	phoneOut: [9.5, 10.4], // the phone turns away, the web app turns in
	webOut: [23.3, 24.2], // and back
	wipe: [4.65, 5.25] // Style-transfer wipe: the sale becomes the inbox
}
// device swaps
const phoneDev = use(
	kf([
		[0, 'opacity:1;transform:none'],
		[T.phoneOut[0], 'opacity:1;transform:none'],
		[T.phoneOut[1], 'opacity:0;transform:translate3d(3.5em,0,-5em) rotateY(38deg)'],
		[23.4, 'opacity:0;transform:translate3d(3.5em,0,-5em) rotateY(38deg)'],
		[24.4, 'opacity:1;transform:none']
	]),
	'ease-in-out'
)
const webDev = use(
	kf([
		[0, 'opacity:0;transform:translate3d(-3.5em,0,-5em) rotateY(-38deg)'],
		[T.phoneOut[0] + 0.1, 'opacity:0;transform:translate3d(-3.5em,0,-5em) rotateY(-38deg)'],
		[T.phoneOut[1] + 0.5, 'opacity:1;transform:none'],
		[T.webOut[0], 'opacity:1;transform:none'],
		[T.webOut[1], 'opacity:0;transform:translate3d(-3.5em,0,-5em) rotateY(-38deg)']
	]),
	'ease-in-out'
)
// the devices sway while screens change and settle near-frontal for the last read of each act
const rock = (steps: [number, number, number, number, number][]) =>
	use(kf(steps.map(([s, y, ry, rx, rz]) => [s, `transform:translateY(${y}em) rotateY(${ry}deg) rotateX(${rx}deg) rotateZ(${rz}deg)`] as [number, string])), 'ease-in-out')
const phoneRock = rock([
	[0, 0.9, -22, 7, -3],
	[1.8, 0.2, -8, 3.5, -1.4],
	[4.2, -0.2, -3, 1.5, -0.6],
	[5.4, -0.4, 8, -1, 1],
	[7.8, -0.2, 2, 0.6, 0.3],
	[9.8, 0.1, -9, 2, -1],
	[24.6, 0.2, -10, 3, -1.2],
	[26.4, -0.2, -3, 1.4, -0.5],
	[28.4, -0.3, 5, -0.8, 0.7],
	[30, 0.9, -22, 7, -3]
])
const webRock = rock([
	[0, 0, -14, 5, -0.8],
	[10.8, 0, -12, 4.5, -0.6],
	[12.8, 0, -7, 3, -0.3],
	[15.6, 0, -10, 4, -0.5],
	[18, 0, -5, 2.2, -0.2],
	[21, 0, -9, 3.6, -0.4],
	[23.4, 0, -7, 2.6, -0.3],
	[30, 0, -14, 5, -0.8]
])
// the camera pushes in on the dock while Yago works, and eases back when the page changes
const webCam = use(
	kf([
		[0, 'transform:scale(1)'],
		[10.9, 'transform:scale(1)'],
		[12.2, 'transform:scale(1.09)'],
		[14.4, 'transform:scale(1.09)'],
		[15.3, 'transform:scale(1.02)'],
		[16.2, 'transform:scale(1.02)'],
		[17.4, 'transform:scale(1.08)'],
		[19.6, 'transform:scale(1.08)'],
		[20.4, 'transform:scale(1.02)'],
		[21.0, 'transform:scale(1.02)'],
		[21.9, 'transform:scale(1.07)'],
		[23.0, 'transform:scale(1.07)'],
		[24.0, 'transform:scale(1)']
	]),
	'ease-in-out'
)

// act 1: the WhatsApp sale (messages stay until the wipe has covered them)
const A = {
	m: [0.45, 1.2, 1.65, 2.4, 3.15, 3.75].map((a) => win(a, 5.3, '.7em')),
	d: [dotsWin(0.75, 1.2), dotsWin(2.7, 3.15)],
	scroll: use(kf([[0, 'transform:translateY(0)'], [2.5, 'transform:translateY(0)'], [3.9, 'transform:translateY(-8em)'], [5.4, 'transform:translateY(-8em)'], [LOOP, 'transform:translateY(-8em)']]), 'ease-in-out'),
	gray: use(kf([[0, 'filter:none'], [T.wipe[0], 'filter:none'], [T.wipe[1], 'filter:grayscale(1) brightness(.85)'], [29.4, 'filter:grayscale(1) brightness(.85)'], [LOOP, 'filter:none']]), 'ease-in-out')
}
// act 2: the inbox: clipped away until the wipe, hidden again once the phone has turned away
const B = use(
	kf([
		[0, 'clip-path:inset(0 0 0 100%);opacity:1'],
		[T.wipe[0], 'clip-path:inset(0 0 0 100%);opacity:1'],
		[T.wipe[1], 'clip-path:inset(0);opacity:1'],
		[T.phoneOut[1], 'clip-path:inset(0);opacity:1'],
		[T.phoneOut[1] + 0.1, 'clip-path:inset(0);opacity:0'],
		[LOOP, 'clip-path:inset(0);opacity:0']
	]),
	'ease-in-out'
)
const wl = use(
	kf([
		[0, 'left:100%;opacity:0'],
		[T.wipe[0] - 0.15, 'left:100%;opacity:0'],
		[T.wipe[0], 'left:100%;opacity:1'],
		[T.wipe[1], 'left:0%;opacity:1'],
		[T.wipe[1] + 0.15, 'left:0%;opacity:0']
	]),
	'ease-in-out'
)
// the phone returns: the mobile app, Yago. Its layer is swapped in while the phone is out of sight.
const C = {
	layer: use(kf([[0, 'opacity:0'], [T.phoneOut[1], 'opacity:0'], [T.phoneOut[1] + 0.1, 'opacity:1'], [29.4, 'opacity:1'], [LOOP, 'opacity:0']])),
	user: win(24.9, 29.4, '.7em'),
	dots: dotsWin(25.7, 26.5),
	card: win(26.5, 29.4, '.7em'),
	strike: use(kf([[0, 'transform:scaleX(0)'], [27.3, 'transform:scaleX(0)'], [27.7, 'transform:scaleX(1)'], [29.4, 'transform:scaleX(1)'], [29.9, 'transform:scaleX(0)']]), 'ease-in-out'),
	press: use(kf([[0, 'transform:none;opacity:1'], [28.2, 'transform:none;opacity:1'], [28.35, 'transform:scale(.94);opacity:1'], [28.5, 'transform:none;opacity:1'], [28.62, 'opacity:0'], [LOOP, 'opacity:0']])),
	pub: use(kf([[0, 'opacity:0;transform:scale(.92)'], [28.55, 'opacity:0;transform:scale(.92)'], [28.8, 'opacity:1;transform:none'], [29.4, 'opacity:1;transform:none'], [29.9, 'opacity:0']]))
}

// the web app: the dashboard page changes with what Yago does; the dock beside it holds three conversations
const W = {
	hl: use(kf([[0, 'transform:translateY(10.5em)'], [14.9, 'transform:translateY(10.5em)'], [15.4, 'transform:translateY(0)'], [22.1, 'transform:translateY(0)'], [22.6, 'transform:translateY(12.6em)'], [LOOP, 'transform:translateY(12.6em)']]), 'ease-in-out'),
	p1: win(9.9, 15.2),
	p2: win(15.0, 22.4),
	p3: win(22.2, 24.4),
	d1: win(10.6, 15.3, '', 0.3),
	d2: win(15.2, 19.9, '', 0.3),
	d3: win(19.8, 24.0, '', 0.3),
	// dock 1: the request, the card, apply
	u1: win(10.8, 15.3, '.6em'),
	dots1: dotsWin(11.6, 12.4),
	c1: win(12.4, 15.3, '.6em'),
	s1: use(kf([[0, 'transform:scaleX(0)'], [13.2, 'transform:scaleX(0)'], [13.6, 'transform:scaleX(1)'], [15.2, 'transform:scaleX(1)'], [15.5, 'transform:scaleX(0)']]), 'ease-in-out'),
	b1: use(kf([[0, 'opacity:1;transform:none'], [13.9, 'opacity:1;transform:none'], [14.05, 'opacity:1;transform:scale(.93)'], [14.2, 'opacity:1;transform:none'], [14.32, 'opacity:0'], [LOOP, 'opacity:0']])),
	k1: use(kf([[0, 'opacity:0'], [14.25, 'opacity:0'], [14.5, 'opacity:1'], [15.2, 'opacity:1'], [15.5, 'opacity:0']])),
	field_old: use(kf([[0, 'opacity:1'], [14.35, 'opacity:1'], [14.65, 'opacity:0'], [15.4, 'opacity:0'], [15.6, 'opacity:0']])),
	field_new: use(kf([[0, 'opacity:0'], [14.35, 'opacity:0'], [14.65, 'opacity:1'], [15.2, 'opacity:1'], [15.5, 'opacity:0']])),
	field_hl: use(kf([[0, 'box-shadow:0 0 0 0 rgba(143,169,184,0)'], [14.35, 'box-shadow:0 0 0 0 rgba(143,169,184,0)'], [14.6, 'box-shadow:0 0 0 .25em rgba(143,169,184,.55)'], [15.2, 'box-shadow:0 0 0 0 rgba(143,169,184,0)']])),
	// dock 2: finds what went wrong
	u2: win(15.6, 19.9, '.6em'),
	y2: win(16.7, 19.9, '.6em'),
	c2: win(17.6, 19.9, '.6em'),
	s2: use(kf([[0, 'transform:scaleX(0)'], [18.3, 'transform:scaleX(0)'], [18.7, 'transform:scaleX(1)'], [19.9, 'transform:scaleX(1)'], [20.2, 'transform:scaleX(0)']]), 'ease-in-out'),
	b2: use(kf([[0, 'opacity:1;transform:none'], [18.9, 'opacity:1;transform:none'], [19.03, 'opacity:1;transform:scale(.93)'], [19.16, 'opacity:1;transform:none'], [19.26, 'opacity:0'], [LOOP, 'opacity:0']])),
	k2: use(kf([[0, 'opacity:0'], [19.2, 'opacity:0'], [19.4, 'opacity:1'], [19.9, 'opacity:1'], [20.2, 'opacity:0']])),
	ring: use(kf([[0, 'opacity:0'], [16.4, 'opacity:0'], [16.8, 'opacity:1'], [19.9, 'opacity:1'], [20.3, 'opacity:0']])),
	// dock 3: guides
	u3: win(20.2, 24.0, '.6em'),
	y3: win(21.0, 24.0, '.6em'),
	link: use(kf([[0, 'background-color:rgba(207,210,245,0)'], [21.7, 'background-color:rgba(207,210,245,0)'], [21.9, 'background-color:rgba(207,210,245,.95)'], [22.4, 'background-color:rgba(207,210,245,.6)'], [LOOP, 'background-color:rgba(207,210,245,.6)']]))
}
// the panel's keyframes must be registered before the stylesheet is joined (the template runs after this block)
const faceSt = faces.map((_, i) => faceKf(i, 'opacity:1', 'opacity:0'))
const agentSt = agents.map((_, i) => faceKf(i, 'opacity:1', 'opacity:.4'))
const dotSt = agents.map((_, i) => faceKf(i, 'background:#cfd2f5', 'background:transparent'))
const lineSt = yagoLines.map((l) => win(l.a, l.b, '', 0.4))
const kfCss = css.join('')

// inbox rows: a 3-row pattern repeated, so a 3-row scroll loops seamlessly
const inbox = [
	{ n: 4.6, p: 8.4, b: 2, c: '#cfd2f5' },
	{ n: 6.2, p: 6.6, b: 0, c: '#d8ece4' },
	{ n: 3.8, p: 9.2, b: 1, c: '#c9dae2' }
]
const rows = Array.from({ length: 21 }, (_, i) => inbox[i % 3])
const ico = {
	signal: "<svg viewBox='0 0 17 11' fill='currentColor'><rect x='0' y='7' width='3' height='4' rx='.6'/><rect x='4.6' y='5' width='3' height='6' rx='.6'/><rect x='9.2' y='2.6' width='3' height='8.4' rx='.6'/><rect x='13.8' y='0' width='3' height='11' rx='.6'/></svg>",
	wifi: "<svg viewBox='0 0 16 11' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round'><path d='M1.5 4a9.2 9.2 0 0 1 13 0M4 6.6a5.7 5.7 0 0 1 8 0'/><circle cx='8' cy='9.2' r='1' fill='currentColor' stroke='none'/></svg>",
	batt: "<svg viewBox='0 0 26 12' fill='none'><rect x='.6' y='.6' width='21.5' height='10.8' rx='3' stroke='currentColor' stroke-opacity='.5'/><rect x='2.2' y='2.2' width='15.5' height='7.6' rx='1.6' fill='currentColor'/><rect x='23.2' y='4' width='1.8' height='4' rx='.8' fill='currentColor' fill-opacity='.5'/></svg>"
}
// sidebar rows of the dashboard stand-in (bars, not labels): [bar width in em, indented]
const side = [
	[7.2, 0],
	[4.4, 0],
	[5.6, 0],
	[4.8, 0],
	[5.2, 0],
	[5.8, 1],
	[3.6, 1]
]
---

<div class='yv relative h-full w-full overflow-hidden'>
	<style is:inline set:html={kfCss}></style>

	<div class='yv-glow'></div>

	<div class='yv-stage' aria-hidden='true'>
		<!-- the web app: the dashboard, with Yago's dock floating above it -->
		<div class='yv-dev yv-devw' style={webDev}>
			<div class='yv-wcam' style={webCam}>
				<div class='yv-web' style={webRock}>
					{wslabs.map((sl) => <i class='yv-wslab' style={`--z:${sl.z}em;background:${sl.c}`}></i>)}
					<div class='yv-wfront'>
						<div class='yv-chrome'><i></i><i></i><i></i><span class='yv-url'>{L.url}</span></div>
						<div class='yv-wbody'>
							<div class='yv-side'>
								<i class='yv-hl' style={W.hl}></i>
								{
									side.map(([w, ind]) => (
										<div class={`yv-sr${ind ? ' yv-sub' : ''}`}>
											<i class='yv-sic'></i>
											<i class='yv-bar' style={`width:${w}em`}></i>
										</div>
									))
								}
							</div>
							<div class='yv-main'>
								<!-- Personality -->
								<div class='yv-pg' style={W.p1}>
									<b class='yv-pt'>{L.personality}</b>
									<div class='yv-card2'>
										<small>{L.styleLong}</small>
										<span class='yv-inp' style={W.field_hl}>
											<span style={W.field_old}>{L.neutral}</span>
											<span class='yv-abs' style={W.field_new}>{L.warm}</span>
										</span>
										<small>{L.audience}</small>
										<span class='yv-inp yv-inp2'><i class='yv-bar' style='width:5em'></i></span>
									</div>
									<div class='yv-card2 yv-card3'>
										<small>{L.handoff}</small>
										<span class='yv-inp yv-inp2'><i class='yv-bar' style='width:8em'></i></span>
									</div>
								</div>
								<!-- Conversations -->
								<div class='yv-pg' style={W.p2}>
