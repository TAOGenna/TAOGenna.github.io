<script>
	import vr from '../../data/tiles/cp_vrating.json'

	const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
	const { virtual, real, stats } = vr
	const N = virtual.length
	const PLAY = 2200 // ms of the vrating replay (the scene lasts 3.6 s: ~1.2 s hold, then the crossfade)
	const lerp = (a: number[], f: number) => {
		const i = Math.min(Math.floor(f), N - 2)
		return a[i] + (a[i + 1] - a[i]) * (f - i)
	}

	document.querySelectorAll<HTMLElement>('[data-cpc]').forEach((root) => {
		if (reduce) return
		const scenes = [...root.querySelectorAll<HTMLElement>('.cpc-scene')]
		const segs = [...root.querySelectorAll<HTMLElement>('.cpc-seg')]
		const plate = root.querySelector<HTMLElement>('.cpc-plate')!

		// ---- vrating replay: driven by cp-start / cp-stop on its scene
		const vrs = root.querySelector<HTMLElement>('.cpc-vr')!
		const clips = [...vrs.querySelectorAll<SVGRectElement>('[data-vr-clip]')]
		const ends = [...vrs.querySelectorAll<SVGGElement>('[data-vr-end]')]
		const $ = (s: string) => vrs.querySelector<HTMLElement>(s)!
		const [v, d, peak, n] = ['[data-vr-v]', '[data-vr-d]', '[data-vr-peak]', '[data-vr-n]'].map($)
		const paint = (p: number) => {
			clips.forEach((c) => c.setAttribute('width', String((+c.dataset.x1! - +c.dataset.x0!) * p)))
			ends.forEach((e) => (e.style.opacity = p >= 0.97 ? '1' : '0'))
			if (p >= 1) {
				v.textContent = String(stats.virtual)
				d.textContent = '+' + stats.delta
				peak.textContent = String(stats.peak)
				n.textContent = String(stats.rounds)
				return
			}
			const f = p * (N - 1)
			let top = 0
			for (let i = 0; i <= Math.floor(f); i++) top = Math.max(top, virtual[i])
			top = Math.max(top, lerp(virtual, f))
			v.textContent = String(Math.round(lerp(virtual, f)))
			const gap = Math.round(lerp(virtual, f) - lerp(real, f))
			d.textContent = (gap < 0 ? '−' : '+') + Math.abs(gap)
			peak.textContent = String(Math.round(top))
			n.textContent = String(Math.floor(f) + 1)
		}
		let raf = 0
		vrs.addEventListener('cp-start', () => {
			cancelAnimationFrame(raf)
			const t0 = performance.now()
			paint(0)
			const tick = (now: number) => {
				const p = Math.min(Math.max((now - t0) / PLAY, 0), 1) // rAF's timestamp can precede t0: never negative
				paint(p)
				if (p < 1) raf = requestAnimationFrame(tick)
			}
			raf = requestAnimationFrame(tick)
		})
		vrs.addEventListener('cp-stop', () => cancelAnimationFrame(raf))

		// ---- the reel: one scene at a time, advance on a timer, hold while hovered
		const DUR = scenes.map((s) => +s.dataset.dur!)
		const tile = root.closest('a')
		let i = -1,
			t = 0,
			left = 0,
			since = 0,
			hovered = false
		const arm = (ms: number) => {
			left = ms
			since = performance.now()
			clearTimeout(t)
			if (!hovered) t = window.setTimeout(() => enter((i + 1) % scenes.length), left)
		}
		const enter = (k: number) => {
			if (scenes[i]) {
				scenes[i].classList.remove('on')
				scenes[i].dispatchEvent(new CustomEvent('cp-stop'))
			}
			i = k
			const s = scenes[k]
			s.classList.remove('on') // restart its one-shot CSS animations from their first frame
			void s.offsetWidth
			s.classList.add('on')
			s.dispatchEvent(new CustomEvent('cp-start'))
			plate.textContent = s.dataset.name!
			segs.forEach((g, j) => {
				g.classList.remove('act')
				g.classList.toggle('done', j < k)
			})
			void root.offsetWidth
			segs[k].style.setProperty('--d', DUR[k] + 'ms')
			segs[k].classList.add('act')
			arm(DUR[k])
		}
		const stop = () => {
			clearTimeout(t)
			if (scenes[i]) scenes[i].dispatchEvent(new CustomEvent('cp-stop'))
			i = -1
		}
		tile?.addEventListener('mouseenter', () => {
			if (i < 0) return
			hovered = true
			clearTimeout(t)
			left -= performance.now() - since
			root.classList.add('cpc-paused')
		})
		tile?.addEventListener('mouseleave', () => {
			if (i < 0) return
			hovered = false
			root.classList.remove('cpc-paused')
			arm(Math.max(left, 300))
		})
		new IntersectionObserver(([e]) => {
			if (e.isIntersecting) {
				if (i < 0) enter(0)
			} else stop()
		}).observe(root)
	})
</script>
