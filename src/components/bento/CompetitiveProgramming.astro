---
// ONE card for github.com/TAOGenna/competitive-programming: five of its works in turn, like Majorana /
// Inversion (~22 s loop): vrating (3.6 s) -> cf-heatmap (4.6 s) -> cf-theme (4.4 s) -> cf-predictor (4.8 s) ->
// the library (4.5 s); no scene idles after its content has landed. Each scene keeps its own surface (glacier plate + pale card, ink colour field, real
// screenshot, glacier quiet type, paper type)
// and animates only while it is the active one: the controller toggles `.on` on the scene and fires
// `cp-start` / `cp-stop` on it (CSS animations live under `.on`; the vrating replay listens to the events). A mono plate (bottom-right) names the tool, a 5-segment ticker (bottom-left) fills
// while it plays.
// The loop starts when the tile is on screen and holds while it is hovered (the hover panel slides over it).
// Static fallback (no JS / reduced motion): the finished vrating card.
// Layout is plain scoped CSS (no Tailwind classes), so it works without a dev-server restart.
//
// DATA (all real, nothing invented):
//  - vrating:  the repo docs' screenshot of an EXAMPLE public career (not the site owner's), digitised by
//              scripts/tile-data/cp_vrating.py -> src/data/tiles/cp_vrating.json. No handle is shown.
//  - heatmap:  the repo's 2022 example profile, digitised cell by cell by scripts/tile-data/cp_heatmap.py ->
//              src/data/tiles/cp_heatmap.json (the day tooltip is the README's own: 2022-05-23, six problems).
//  - theme:    the repo's own light/dark screenshots, cropped by scripts/tile-data/cp_theme.py (no standings
//              rows, so no other users' handles). The round ☀/☾ switch on the wipe edge is drawn here.
//  - predictor: a mini Codeforces STANDINGS table (Educational Round 195) with the Δ column the userscript adds.
//              REAL, read off cf-predictor/.github/readme/cf-predictor.png: every rank, solved count and penalty
//              (1: 7/356, 2: 7/373, 3: 6/121, 4: 6/138, 5: 6/140, 6: 6/144, 7: 6/151, 8: 6/154, 8: 6/154) and the
//              four deltas (+262, +217, +217, +227); the blank Δ cells are real too (users above the 2100 cap are
//              official but unrated). "99% within +-1 rating point on Div. 1" is the README accuracy table
//              (contests 1889, 2196). ILLUSTRATIVE: the "Who" placeholders (no handles): the hairline lengths are
//              arbitrary and the dot hues just follow the cap rule (warm tiers = at/above 2100, cool = below).
//  - library:  the topic counts parsed from the repo README by scripts/tile-data/cp_library.py ->
//              src/data/tiles/cp_library.json.
import vr from '../../data/tiles/cp_vrating.json'
import hm from '../../data/tiles/cp_heatmap.json'
import lib from '../../data/tiles/cp_library.json'

// ---------------------------------------------------------------- vrating (chart geometry)
const { virtual, real, tiers, ticks, range, stats } = vr
const [LO, HI] = range
const N = virtual.length
const mono = 'font-family:ui-monospace,SFMono-Regular,Menlo,monospace'
const INK = '#0b0f14'
const STEEL = '#7e8ea1'
const tint = ['#eceeef', '#dcebdf', '#d3ebe6', '#d6dcf3', '#e5d8f0', '#efe3d4', '#f2dbd8', '#f0d0cf', '#e9c3c2']
const layouts = [
	{ name: 'wide', W: 498, H: 184, l: 27, r: 44, t: 6, b: 15, dot: 2 },
	{ name: 'narrow', W: 294, H: 184, l: 25, r: 36, t: 6, b: 15, dot: 1.7 }
].map((c) => {
	const x0 = c.l,
		x1 = c.W - c.r,
		y0 = c.t,
		y1 = c.H - c.b
	const X = (i: number) => x0 + ((x1 - x0) * i) / (N - 1)
	const Y = (r: number) => y0 + ((HI - r) / (HI - LO)) * (y1 - y0)
	const line = (a: number[]) => a.map((r, i) => `${i ? 'L' : 'M'}${X(i).toFixed(1)} ${Y(r).toFixed(1)}`).join('')
	const back = real.map((r, i) => `L${X(N - 1 - i).toFixed(1)} ${Y(real[N - 1 - i]).toFixed(1)}`).join('')
	return { ...c, x0, x1, y0, y1, X, Y, virt: line(virtual), real: line(real), gap: line(virtual) + back + 'Z' }
})

// ---------------------------------------------------------------- heatmap
const P = 10, // cell pitch in svg units (cell = 8)
	COLS = 53,
	ROWS = 7
const TIER_MIN = [3000, 2600, 2400, 2300, 2100, 1900, 1600, 1400, 1200, 0] // highest first = digit in hm.cells
const FILL = ['#b3262c', '#ff4d4d', '#ff8f8f', '#f4b86a', '#f6d3a3', '#e06be0', '#a9adf2', '#7fd8bd', '#8de68d', '#b9bec4']
const tierOf = (rating: number) => TIER_MIN.findIndex((m) => rating >= m)
// Jan 1 2022 is a Saturday: day d sits in column (d+6)/7, row (d+6)%7 (rows start on Sunday)
const pos = (d: number) => [Math.floor((d + 6) / 7), (d + 6) % 7]
const days = hm.cells.split('')
const lit = days.map((k, d) => ({ k, d })).filter((x) => x.k !== '.')
const empty = days.map((k, d) => ({ k, d })).filter((x) => x.k === '.')
const delay = (d: number) => (0.25 + (d / 364) * 1.9).toFixed(2) // the sweep runs 0.25 s -> 2.15 s
const [fc, fr] = pos(142) // 2022-05-23, the README's tooltip day
const problems: [string, number][] = [
	['Game with Cards', 800],
	['Card Trick', 800],
	['Double Sort', 1200],
	['Unique Occurrences', 2300],
	['Required Length', 1700],
	['Labyrinth Adventures', 2600]
]
const hardest = Math.max(...problems.map((p) => p[1]))
const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
const first = [0, 31, 59, 90, 120, 151, 181, 212, 243, 273, 304, 334]

// ---------------------------------------------------------------- library
const max = Math.max(...lib.topics.map((t) => t.count))
const ranked = [...lib.topics].sort((a, b) => b.count - a.count || a.name.localeCompare(b.name))
const rank = new Map(ranked.map((t, i) => [t.name, i]))
const h = (s: string) => [...s].reduce((a, c) => (Math.imul(a, 31) + c.charCodeAt(0)) >>> 0, 7) % 9973 // fixed shuffle
const words = [...lib.topics]
	.sort((a, b) => h(a.name) - h(b.name))
	.map((t) => {
		const k = Math.sqrt(t.count / max)
		return {
			name: t.name,
			f: (6.5 + 16 * k).toFixed(1), // px at full size
			o: (0.3 + 0.7 * k ** 0.9).toFixed(2), // ink opacity
			g: h(t.name + '!') % 6, // blur-in group
			r: rank.get(t.name)!,
			tone: t.name === 'dp' || t.name === 'dijkstra' ? 'mark' : t.name === 'segment tree' ? 'steel' : ''
		}
	})
const problemsN = lib.problems.toLocaleString('en')

// ---------------------------------------------------------------- predictor
// real rows of the README screenshot; d = null where Codeforces shows no delta (above the cap)
const std: { r: number; s: number; p: number; d: number | null; dot: string; w: number; x?: boolean }[] = [
	{ r: 1, s: 7, p: 356, d: null, dot: '#ff4d4d', w: 58 },
	{ r: 2, s: 7, p: 373, d: 262, dot: '#e06be0', w: 44 },
	{ r: 3, s: 6, p: 121, d: 217, dot: '#a9adf2', w: 70 },
	{ r: 4, s: 6, p: 138, d: null, dot: '#ff4d4d', w: 52 },
	{ r: 5, s: 6, p: 140, d: null, dot: '#ff8f8f', w: 38, x: true },
	{ r: 6, s: 6, p: 144, d: null, dot: '#f4b86a', w: 62, x: true },
	{ r: 7, s: 6, p: 151, d: null, dot: '#f6d3a3', w: 46, x: true },
	{ r: 8, s: 6, p: 154, d: 217, dot: '#a9adf2', w: 66 },
	{ r: 8, s: 6, p: 154, d: 227, dot: '#e06be0', w: 50 }
]
let pillK = 0
const rows = std.map((x) => ({ ...x, k: x.d === null ? -1 : pillK++ }))
---

<div data-cpc class='cpc'>
	<!-- 1 · vrating -->
	<div class='cpc-scene cpc-vr on' data-name='vrating' data-dur='3600'>
		<div class='vr-glow'></div>
		<div class='vr-card'>
			<div class='vr-stats'>
				<div>
					<p class='vr-cap'>Virtual rating</p>
					<p class='vr-num' data-vr-v>{stats.virtual}</p>
				</div>
				<div>
					<p class='vr-cap'>vs real</p>
					<p class='vr-num vr-nowrap'><span class='vr-mark' data-vr-d>+{stats.delta}</span><span class='vr-vs'>vs {stats.real}</span></p>
				</div>
				<div class='vr-more'>
					<p class='vr-cap'>Peak</p>
					<p class='vr-num' data-vr-peak>{stats.peak}</p>
				</div>
				<div class='vr-more'>
					<p class='vr-cap'>Rounds replayed</p>
					<p class='vr-num' data-vr-n>{stats.rounds}</p>
				</div>
			</div>

			<div class='vr-chart'>
				{
					layouts.map((g) => {
						const wide = g.name === 'wide'
						const lastX = g.X(N - 1)
						return (
							<svg
								data-vr={g.name}
								viewBox={`0 0 ${g.W} ${g.H}`}
								preserveAspectRatio='xMidYMid meet'
								class={wide ? 'vr-w' : 'vr-n'}
								role='img'
								aria-label='A virtual rating career replayed round by round: the rating the virtual rounds would have given, dashed against the real rating, with the gap between them highlighted'
							>
								<defs>
									<clipPath id={`cpc-vc-${g.name}`}>
										<rect data-vr-clip data-x0={g.x0 - 3} data-x1={g.x1 + 3} x={g.x0 - 3} y='0' width={g.x1 - g.x0 + 6} height={g.H} />
									</clipPath>
									<clipPath id={`cpc-vp-${g.name}`}><rect x={g.x0} y={g.y0} width={g.x1 - g.x0} height={g.y1 - g.y0} /></clipPath>
								</defs>
								<g clip-path={`url(#cpc-vp-${g.name})`}>
									{tiers.map((t, k) => <rect x={g.x0} width={g.x1 - g.x0} y={g.Y(t.hi).toFixed(1)} height={(g.Y(t.lo) - g.Y(t.hi)).toFixed(1)} fill={tint[k]} />)}
									<g stroke='#fff' stroke-opacity='0.7' stroke-width='0.6'>
										{tiers.slice(1).map((t) => <line x1={g.x0} x2={g.x1} y1={g.Y(t.lo).toFixed(1)} y2={g.Y(t.lo).toFixed(1)} />)}
									</g>
								</g>
								<g font-size='6.5' fill={INK} fill-opacity='0.5' style={mono}>
									{[1600, 2000, 2400, 2800, 3200].map((r) => <text x={g.x0 - 4} y={(g.Y(r) + 2.2).toFixed(1)} text-anchor='end'>{r}</text>)}
									{ticks.filter((t) => wide || t.i !== 7).map((t, k) => <text x={g.X(t.i).toFixed(1)} y={g.H - 3} text-anchor={k === 0 ? 'start' : 'middle'} fill-opacity='0.45'>{t.label}</text>)}
								</g>
								<g clip-path={`url(#cpc-vc-${g.name})`}>
									<path d={g.gap} fill='#cfd2f5' fill-opacity='0.7' />
									<path d={g.real} fill='none' stroke={STEEL} stroke-width='1' stroke-dasharray='3 2.6' stroke-linejoin='round' />
									<path d={g.virt} fill='none' stroke={INK} stroke-width={wide ? 1.5 : 1.4} stroke-linejoin='round' stroke-linecap='round' />
									<g fill='#f6f8fa' stroke={INK} stroke-width='1'>
										{virtual.map((r, i) => <circle cx={g.X(i).toFixed(1)} cy={g.Y(r).toFixed(1)} r={g.dot} />)}
									</g>
									<circle cx={lastX.toFixed(1)} cy={g.Y(virtual[N - 1]).toFixed(1)} r='5.2' fill='#cfd2f5' fill-opacity='0.8' />
									<circle cx={lastX.toFixed(1)} cy={g.Y(virtual[N - 1]).toFixed(1)} r={g.dot + 0.4} fill='#f6f8fa' stroke={INK} stroke-width='1.1' />
								</g>
								<g data-vr-end font-size='6.5' style={mono}>
									<text x={lastX + 7} y={(g.Y(virtual[N - 1]) + 2.2).toFixed(1)} fill={INK} font-weight='600'>virtual</text>
									<text x={lastX + 7} y={(g.Y(real[N - 1]) + 2.2).toFixed(1)} fill={STEEL}>real</text>
								</g>
							</svg>
						)
					})
				}
			</div>
		</div>
	</div>

	<!-- 2 · cf-heatmap -->
	<div class='cpc-scene cpc-hm' data-name='cf-heatmap' data-dur='4600'>
		<div class='hm-in'>
			<div class='hm-legend' aria-hidden='true'>
				<span class='hm-lt'>hardest problem that day</span>
				<span class='hm-sw'>{[...FILL].reverse().map((c) => <i style={`background:${c}`} />)}</span>
			</div>

			<div class='hm-body'>
				<div class='hm-months' aria-hidden='true'>
					{MONTHS.map((m, i) => <span style={`left:${(pos(first[i])[0] * 100) / COLS}%`}>{m}</span>)}
				</div>
				<svg
					viewBox={`0 0 ${COLS * P} ${ROWS * P}`}
					class='hm-svg'
					role='img'
					aria-label={`The 2022 Codeforces heatmap of an example profile: ${lit.length} days coloured by the hardest problem solved, from grey below 1200 to dark red at 3000 and above`}
				>
					<g fill='none' stroke='#e9edf0' stroke-opacity='0.14' stroke-width='0.5'>
						{empty.map(({ d }) => <rect x={pos(d)[0] * P + 0.25} y={pos(d)[1] * P + 0.25} width='7.5' height='7.5' rx='1.2' />)}
					</g>
					<g>
						{lit.map(({ k, d }) => <rect class='hm-c' x={pos(d)[0] * P} y={pos(d)[1] * P} width='8' height='8' rx='1.2' fill={FILL[+k]} style={`--t:${delay(d)}s`} />)}
					</g>
					<rect class='hm-ring' x={fc * P - 1.5} y={fr * P - 1.5} width='11' height='11' rx='2.2' fill='none' stroke='#fff' stroke-width='1' />
					<rect class='hm-sweep' x='-1' y='-4' width='1' height={ROWS * P + 8} fill='#cfd2f5' />
				</svg>
			</div>

			<div class='hm-detail'>
				<div class='hm-tip'>
					<p class='hm-th'>2022-05-23<span> · {problems.length} problems</span></p>
					<ul>
						{
							problems.map(([name, r]) => (
								<li class={r === hardest ? 'hm-top' : ''}>
									<i style={`background:${FILL[tierOf(r)]}`} />
									<span>{name}</span>
									<b>{r}</b>
								</li>
							))
						}
					</ul>
				</div>
				<div class='hm-stat'>
					<p class='hm-n'>{lit.length}</p>
					<p class='hm-sc'>days solved · 2022</p>
				</div>
			</div>
		</div>
	</div>

	<!-- 3 · cf-theme -->
	<div class='cpc-scene cpc-ct' data-name='cf-theme' data-dur='4400'>
		<div class='ct-sheet' style='background:#eef4f1'>
			<img src='/projects/tiles/cp_theme_light.jpg' alt='Codeforces in the light theme: pale sage page, pastel bars under each menu item' loading='lazy' decoding='async' />
		</div>
		<div class='ct-sheet ct-dark' style='background:#050505'>
			<img src='/projects/tiles/cp_theme_dark.jpg' alt='The same Codeforces page in the dark theme, with rank and link colours kept' loading='lazy' decoding='async' />
		</div>
		<i class='ct-line' aria-hidden='true'></i>
		<span class='ct-btn' aria-hidden='true'>
			<svg class='ct-moon' viewBox='0 0 24 24' fill='currentColor'><path d='M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a.6.6 0 0 0-.8-.7A9.5 9.5 0 1 0 21.2 15a.6.6 0 0 0-.7-.8z' /></svg>
			<svg class='ct-sun' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round'>
				<circle cx='12' cy='12' r='4' fill='currentColor' stroke='none' />
				<path d='M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8' />
			</svg>
		</span>
	</div>

	<!-- 4 · cf-predictor -->
	<div
		class='cpc-scene cpc-pd'
		data-name='cf-predictor'
		data-dur='4800'
		role='img'
		aria-label='cf-predictor adds a delta column to Codeforces standings: the rating change each contestant is about to get, shown before Codeforces applies it'
	>
		<div class='pd-wrap'>
			<div class='pd-table' aria-hidden='true'>
				<div class='pd-head pd-grid'>
					<span>#</span><span>Who</span><span>=</span><span class='pd-pen'>Penalty</span>
					<span class='pd-dcell'><b class='pd-hwait'>Δ…</b><b class='pd-hdone'>Δ</b></span>
				</div>
				{
					rows.map((x) => (
						<div class:list={['pd-row pd-grid', x.x && 'pd-x']}>
							<span class='pd-n pd-rk'>{x.r}</span>
							<span class='pd-who'>
								<i style={`background:${x.dot}`} />
								<u style={`width:${x.w}px`} />
							</span>
							<span class='pd-n'>{x.s}</span>
							<span class='pd-n pd-pen'>{x.p}</span>
							<span class='pd-dcell'>
								{x.d !== null && (
									<span class='pd-pill' style={`--k:${x.k}`}>
										<em>▲</em>+{x.d}
									</span>
								)}
							</span>
						</div>
					))
				}
			</div>
			<p class='pd-foot'>Blank = rating over 2100, unrated here</p>
			<p class='pd-cap'>Rating change, shown before Codeforces applies it</p>
			<p class='pd-mono'>Runs in the browser, no server. Div. 1: 99% within ±1 of the real change.</p>
		</div>
	</div>

	<!-- 5 · library -->
	<div class='cpc-scene cpc-lb' data-name='library' data-dur='4500'>
		<div class='lb-head'>
			<p class='lb-a lb-g0 lb-num'>{problemsN}</p>
			<p class='lb-a lb-g2 lb-cap'>problems · {lib.nTopics} topics</p>
			<p class='lb-a lb-g3 lb-cap lb-cap2'>{lib.templates} templates · {lib.blogs} blog posts</p>
		</div>
		<div class='lb-cloud' aria-hidden='true'>
			{
				words.map((w) => (
					<span
						class:list={['lb-w lb-a', `lb-g${w.g}`, w.tone && `lb-${w.tone}`, w.r >= 18 && 'lb-sm-hide', w.r >= 48 && 'lb-md-hide']}
						style={`--f:${w.f};--o:${w.o}`}>{w.name}</span>
				))
			}
			<i class='lb-fill'></i>
		</div>
	</div>

	<!-- frame: progress ticker (bottom-left) + tool plate (bottom-right) -->
	<div class='cpc-tick' aria-hidden='true'><i class='cpc-seg done'></i><i class='cpc-seg'></i><i class='cpc-seg'></i><i class='cpc-seg'></i><i class='cpc-seg'></i></div>
	<span class='cpc-plate' aria-hidden='true'>vrating</span>
</div>

<style>
	.cpc {
		position: absolute;
		inset: 0;
		overflow: hidden;
	}
	.cpc-scene {
		position: absolute;
		inset: 0;
		overflow: hidden;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.55s;
	}
	.cpc-scene.on {
		opacity: 1;
	}

	/* ---------- frame ---------- */
	.cpc-tick {
		position: absolute;
		left: 12px;
		bottom: 12px;
		z-index: 10;
		display: flex;
		gap: 3px;
		padding: 8px 8px;
		border-radius: 4px;
		background: #0b0f14;
	}
	.cpc-seg {
		position: relative;
		display: block;
		width: 18px;
		height: 2px;
		overflow: hidden;
		background: rgb(241 239 234 / 0.22);
	}
	.cpc-seg::after {
		content: '';
		position: absolute;
		inset: 0;
		background: #f1efea;
		transform: scaleX(0);
		transform-origin: left;
	}
	.cpc-seg.done::after {
		transform: scaleX(1);
	}
	.cpc-seg.act::after {
		animation: cpc-fill var(--d) linear forwards;
	}
	@keyframes cpc-fill {
		to {
			transform: scaleX(1);
		}
	}
	:global(.cpc-paused) .cpc-seg.act::after {
		animation-play-state: paused;
	}
	.cpc-plate {
		position: absolute;
		right: 12px;
		bottom: 12px;
		z-index: 10;
		padding: 5px 8px;
		border-radius: 4px;
		background: #0b0f14;
		color: #f1efea;
		font: 500 0.5rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	/* ---------- 1 · vrating ---------- */
	.cpc-vr {
		background: #cfdde4;
	}
	.vr-glow {
		position: absolute;
		right: -8%;
		top: -6%;
		width: 70%;
		height: 80%;
		pointer-events: none;
		background: radial-gradient(closest-side, rgba(207, 210, 245, 0.85), rgba(207, 210, 245, 0) 72%);
		filter: blur(22px);
	}
	.cpc-vr.on .vr-glow {
		animation: vr-drift 15s ease-in-out infinite alternate;
	}
	@keyframes vr-drift {
		from {
			transform: translate(6%, 2%) scale(0.94);
		}
		to {
			transform: translate(-5%, 6%) scale(1.06);
		}
	}
	.vr-card {
		position: absolute;
		left: 12px;
		right: 12px;
		top: 44px;
		bottom: 44px;
		max-width: 640px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		padding: 12px 16px 10px;
		border-radius: 5px;
		background: #f6f8fa;
		color: #0b0f14;
		transform: rotate(1.5deg);
		transform-origin: 50% 60%;
		box-shadow:
			0 20px 36px -14px rgba(11, 15, 20, 0.5),
