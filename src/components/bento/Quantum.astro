---
// Texture format. The project's own 18-vertex graph (src/assets/quantum_communication.png, digitized by
// scripts/tile-data/quantum_graph.py → src/data/tiles/quantum.json: 18 vertices, 44 edges) is turned into a scalar field,
// a Gaussian bump on every vertex plus a weaker ridge along every edge. It first shows as pale blurred shapes; then the
// blur resolves into a sparse field of digits that sit only on the field's contour lines (the "ASCII number
// structures" of the Hermeneutic reference; same technique as the Soil tile). The digits are texture, not data.
import g from '../../data/tiles/quantum.json'

const COLS = 50,
	ROWS = 15,
	CW = 5.4, // px per cell at 9px mono
	CH = 10.5
const gh = ROWS * CH * 0.86 // graph box in px (a little shorter than the field, so the rim stays free)
const gw = gh * g.aspect
const ox = (COLS * CW - gw) / 2
const oy = 9
const at = (k: number) => {
	const [x, y] = (g.v as Record<string, [number, number]>)[k]
	return [ox + x * gw, oy + y * gh] as [number, number]
}
const V = Object.keys(g.v).map((k) => at(+k))
const E = (g.e as [number, number][]).map(([a, b]) => [at(a), at(b)])

// bumps: (x, y, amplitude, sigma) in px
const bumps: [number, number, number, number][] = V.map(([x, y]) => [x, y, 1, 8.5])
E.forEach(([[x1, y1], [x2, y2]]) => {
	const n = Math.max(2, Math.round(Math.hypot(x2 - x1, y2 - y1) / 9))
	for (let i = 1; i < n; i++) bumps.push([x1 + ((x2 - x1) * i) / n, y1 + ((y2 - y1) * i) / n, 0.34, 6])
})
const val = (c: number, r: number) => {
	const px = (c + 0.5) * CW,
		py = (r + 0.5) * CH
	let v = 0
	for (const [x, y, a, s] of bumps) v += a * Math.exp(-((px - x) ** 2 + (py - y) ** 2) / (2 * s * s))
	return v
}
const LEVELS = 5
const field = Array.from({ length: ROWS }, (_, r) => Array.from({ length: COLS }, (_, c) => val(c, r)))
const lv = field.map((row) => row.map((v) => Math.min(Math.floor(v * LEVELS * 0.62), LEVELS)))
// fixed per-cell hash → sparse, non-flickering dotted contours plus a few strays
const hash = (c: number, r: number) => Math.abs(((c * 73856093) ^ (r * 19349663)) % 1000) / 1000
let digits = '',
	glow = ''
for (let r = 0; r < ROWS; r++) {
	for (let c = 0; c < COLS; c++) {
		const L = lv[r][c]
		const edge = L >= 1 && ((c < COLS - 1 && lv[r][c + 1] !== L) || (r < ROWS - 1 && lv[r + 1][c] !== L))
		digits += (edge ? hash(c, r) < 0.5 : L >= 1 && hash(c, r) < 0.02) ? String(Math.min(L + 3, 9)) : ' '
		glow += field[r][c] > 0.3 ? '█' : ' '
	}
	digits += '\n'
	glow += '\n'
}
---

<div class='qc relative h-full w-full overflow-hidden'>
	<div class='qc-box absolute inset-x-0 bottom-0' style='top:10px'>
		<pre aria-hidden='true' class='qc-glow'>{glow}</pre>
		<pre aria-hidden='true' class='qc-digits'>{digits}</pre>
	</div>
	<div class='absolute inset-x-0 bottom-0 h-[48%] bg-gradient-to-t from-[#0b0f14] via-[#0b0f14]/60 to-transparent'></div>
	<div class='absolute bottom-3 left-4'>
		<p class='font-newsreader text-[3.4rem] font-light leading-none tracking-tight text-[#e9edf0]'>18</p>
		<p class='mt-1 font-mono text-[0.5rem] uppercase tracking-wider text-[#e9edf0]/55'>vertices · 44 edges · fig 13</p>
	</div>
</div>

<style>
	.qc-box {
		-webkit-mask-image: linear-gradient(to bottom, #000 48%, transparent 84%);
		mask-image: linear-gradient(to bottom, #000 48%, transparent 84%);
	}
	.qc-glow,
	.qc-digits {
		position: absolute;
		top: 0;
		left: 50%;
		translate: -50% 0;
		margin: 0;
		font: 9px/10.5px ui-monospace, SFMono-Regular, Menlo, monospace;
		white-space: pre;
		pointer-events: none;
		user-select: none;
	}
	.qc-glow {
		color: rgba(207, 210, 245, 0.5);
		animation: qc-haze 11s ease-in-out infinite;
	}
	.qc-digits {
		color: #e9edf0;
		animation: qc-focus 11s ease-in-out infinite;
	}
	/* pale blurred shapes → digits resolve → back to haze */
	@keyframes qc-haze {
		0%,
		12% {
			filter: blur(7px);
			opacity: 0.95;
		}
		40%,
		84% {
			filter: blur(5px);
			opacity: 0.4;
		}
		100% {
			filter: blur(7px);
			opacity: 0.95;
		}
	}
	@keyframes qc-focus {
		0%,
		14% {
			filter: blur(5px);
			opacity: 0;
		}
		40%,
		80% {
			filter: blur(0);
			opacity: 0.7;
		}
		96%,
		100% {
			filter: blur(5px);
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.qc-glow,
		.qc-digits {
			animation: none;
		}
		.qc-glow {
			filter: blur(5px);
			opacity: 0.4;
		}
		.qc-digits {
			opacity: 0.85;
		}
	}
</style>
